# Copy to .env.worker on the VM (never commit the real file).
#   cp env.worker.example .env.worker
#
# pm2 on the VPS is the primary runbook (WORKER.md).
# Same Turso + R2 + TTS keys as Vercel. This process synthesizes Whole book.
# It also parses uploads (POST /extract) in a child process.
# EXTRACT_NODE_CONCURRENCY=1

# ── Shared secret (must match Vercel WORKER_SECRET) ──
WORKER_SECRET=
# INTERNAL_JOB_SECRET=   # optional alias; WORKER_SECRET alone is enough

# ── Turso ────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=

# ── Cloudflare R2 ────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=echomancer-audio
# R2_PUBLIC_URL=

# Apify token for allowlisted YouTube section clips. Never log this.
# Leave unset to keep the worker on Whole book only.
# APIFY_TOKEN=
# APP_DAILY_APIFY_USD=2
# Sources at least this long use the segment actor first (seconds, default 1800).
# CLIP_SEGMENT_SOURCE_SEC=1800

# ── TTS ──────────────────────────────────────────────────────────────────
# Edge stock (Andrew / Ava / Libby / Ryan) needs no extra key.
FISH_API_KEY=
# Clone synthesis. Default is the self-hosted S2-Pro on Modal: set both MODAL_S2_*
# below and clones use it. Drama 3 is the automatic fallback, then direct Fish.
# Rollback: CLONE_TTS_PROVIDER=openrouter (Drama 3 only) or fish (direct Fish only).
# CLONE_TTS_PROVIDER=
# S2-Pro clone endpoint (modal/s2_clone_service.py). Without a URL clones fall
# back to Drama 3, so a missing value degrades rather than breaks.
MODAL_S2_TTS_URL=
# Bearer token; same value as the Modal `echomancer-s2-api` secret.
MODAL_S2_TOKEN=
# Sections per HTTP call. The container decodes them in one batch, so GPU cost
# is nearly flat in this number. Keep <= the worker's S2B_BATCH (32). Default 24.
# MODAL_S2_BATCH_SIZE=24
# Concurrent batch calls for one book. Default 2.
# MODAL_S2_SECTION_CONCURRENCY=2
# Sampling as "temperature,top_p". 0.9,0.9 restores the reference's phrasing
# (measured 6.1 vs 6.2 semitones of phrase spread); upstream 0.7,0.7 is flat.
# MODAL_S2_SAMPLING=0.9,0.9
# Warm-call ceiling, clamped to 30–60s. Default 60s. A cold compile takes
# ~20 min, so this aborts and the section falls back to Drama 3.
# MODAL_S2_TIMEOUT_MS=60000
# Readiness probe. Default on: GET ${MODAL_S2_TTS_URL}/ready, or MODAL_S2_READY_URL
# when set (the CPU endpoint from modal/s2_clone_service.py, which does not start
# a GPU). 404 means the route is not deployed yet and synthesis still runs.
# Timeout or 503 skips Modal for 30s. Set MODAL_S2_READY=0 until that CPU URL
# exists, so the probe does not hit the GPU host and cold-start an H100.
# MODAL_S2_READY_URL=
# MODAL_S2_READY_TIMEOUT_MS=5000
# MODAL_S2_READY=0
# Daily character caps for clone audio sent to Modal. A book that does not fit
# uses Drama 3 for every remaining section. 0 refuses Modal. off disables the cap.
# Defaults: 500000 per user, 2000000 global, UTC day.
# MODAL_S2_USER_DAILY_CHARS=500000
# MODAL_S2_GLOBAL_DAILY_CHARS=2000000
# Same key as Vercel — listen-prep fallback, and section transcript QA
# (deepgram/nova-3). The request is aborted at
# 5s of wall clock on a worker thread. TTS_SECTION_QA_ENABLED=0 skips QA
# even when a key is set.
OPENROUTER_API_KEY=
# Squeak check is off. A labelled set of 10 detector hits had 0 true squeaks.
# TTS_SQUEAK_CHECK=1 turns detection and the notch back on.
# TTS_SQUEAK_REGENERATE=1 also re-speaks the whole section. Leave both unset.
# TTS_SQUEAK_CHECK=1
# TTS_SQUEAK_REGENERATE=1
# Whole-book cleanup. MiMo first (reasoning off); DeepSeek only as a checked fallback.
# Leave LISTEN_PREP_MODEL unset to use the code default. An explicit Gemini value overrides it.
# LISTEN_PREP_MODEL=xiaomi/mimo-v2.6-flash
# LISTEN_PREP_REASONING=off
# LISTEN_PREP_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# LISTEN_PREP_CONCURRENCY=8
# LISTEN_PREP_GLOBAL_CONCURRENCY=20
# LISTEN_PREP_CHUNK_TIMEOUT_MS=20000
# GEMINI_API_KEY=
# XAI_API_KEY=

# ── Paradee (self-hosted "Echomancer Andrew") ────────────────────────────
# The Python sidecar in scripts/paradee/server.py (see scripts/paradee/README.md).
# Leave PARADEE_URL empty on Vercel; the worker proxies /paradee/synthesize.
PARADEE_URL=http://127.0.0.1:8791
# Optional. When the sidecar sets PARADEE_SECRET, this process and the worker
# proxy must send the same value as a Bearer token.
# PARADEE_SECRET=
# Paradee sections in flight for one book (the CPU student is the bottleneck).
TTS_PARADEE_FANOUT=3

# ── Worker knobs ─────────────────────────────────────────────────────────
# Keep concurrency at 1 until a full book has mastered without the OOM killer.
# pm2 also sets WORKER=1, WORKER_HOST=127.0.0.1, TTS_MASTER_FULL_BOOK=1.
WORKER_CONCURRENCY=1
WORKER_DRAIN_INTERVAL_MS=15000
TTS_VM_WAVE_BUDGET_MS=900000
TTS_LEASE_TTL_SECONDS=90
TTS_SECTIONS_PER_TICK=8
# Edge and Google sections in one book. Fish and clones ignore this (max 5).
TTS_EDGE_GOOGLE_SECTION_CONCURRENCY=8
TTS_TAKEHOME_FANOUT=
TTS_RETRY_BACKOFF_MS=1000
# WORKER_HOST=127.0.0.1
# DEEP_FILTER_BIN=/usr/local/bin/deep-filter
# TTS_MASTER_SKIP=1
# TTS_MASTER_DFN=1
# TTS_MASTER_DFN_WET=0.4
# FFMPEG_PATH=/usr/bin/ffmpeg
# ECHOMANCER_SCRATCH_DIR=/tmp/echomancer
# ECHOMANCER_SCRATCH_MAX_AGE_HOURS=24
# ECHOMANCER_SCRATCH_SWEEP_MS=900000
# TTS_FINALIZE_TIMEOUT_MS=21600000

# ── Printed-contents topic placement ─────────────────────────────────────
# Intended path: hosted embeddings (OpenAI-compatible /embeddings).
# Default: OpenRouter qwen/qwen3-embedding-8b on OPENROUTER_API_KEY above
# ($0.01 / 1M tokens, ~$0.0015 a book).
# CHAPTER_TOPIC_EMBED=1
# CHAPTER_EMBED_PROVIDER=openrouter   # or deepinfra (DEEPINFRA_API_KEY) / cloudflare
# CHAPTER_EMBED_MODEL=qwen/qwen3-embedding-8b   # deepinfra: google/embeddinggemma-300m
# CHAPTER_EMBED_API_KEY=              # overrides the provider key
# CHAPTER_EMBED_BASE_URL=             # any other OpenAI-compatible host
# CHAPTER_EMBED_MIN_SIMILARITY=0.35
# DEEPINFRA_API_KEY=
# CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Optional chat-model fallback (runs when embeddings are off or fail).
# CHAPTER_TOPIC_LLM=1
