# Copy to .env.worker on the VM (never commit the real file).
#   cp env.worker.example .env.worker
#
# pm2 on the VPS is the primary runbook (WORKER.md).
# Same Turso + R2 + TTS keys as Vercel. This process synthesizes Whole book.
# It also parses uploads (POST /extract) in a child process.
# EXTRACT_NODE_CONCURRENCY=1

# ── Shared secret (must match Vercel WORKER_SECRET) ──
WORKER_SECRET=
# INTERNAL_JOB_SECRET=   # optional alias; WORKER_SECRET alone is enough

# ── Turso ────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=

# ── Cloudflare R2 ────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=echomancer-audio
# R2_PUBLIC_URL=

# Apify token for allowlisted YouTube section clips. Never log this.
# Leave unset to keep the worker on Whole book only.
# APIFY_TOKEN=
# APP_DAILY_APIFY_USD=2
# Sources at least this long use the segment actor first (seconds, default 1800).
# CLIP_SEGMENT_SOURCE_SEC=1800

# ── TTS ──────────────────────────────────────────────────────────────────
# Edge stock (Andrew / Ava / Libby / Ryan) needs no extra key.
FISH_API_KEY=
# Clone synthesis. Default is the self-hosted S2-Pro on Modal: set both MODAL_S2_*
# below and clones use it. Direct Fish is the only fallback — the same voice,
# because Fish trained the reference. There is no Drama 3 rung and no substitute
# voice; a preview or a section that cannot use either engine fails visibly.
# Rollback: CLONE_TTS_PROVIDER=fish (direct Fish only).
# CLONE_TTS_PROVIDER=
# S2-Pro clone endpoints (modal/s2_clone_service.py). Each
# @modal.fastapi_endpoint is served at the ROOT of its own hostname, so there is
# one absolute URL per endpoint and nothing is appended to them.
#   MODAL_S2_TTS_URL          the synthesize_batch host   (required)
#   MODAL_S2_SYNTHESIZE_URL   the synthesize host          (optional)
#   MODAL_S2_READY_URL        the ready probe host         (optional)
# Without a batch URL clones use direct Fish. Without a synthesize URL a
# single-section call is sent as a one-row batch — never as a single-section
# body posted at the batch host, which the container rejects after restoring.
# A URL with a path is rejected at startup: that is always someone appending a
# route onto a Modal subdomain.
MODAL_S2_TTS_URL=
# MODAL_S2_SYNTHESIZE_URL=
# MODAL_S2_READY_URL=
# Bearer token; same value as the Modal `echomancer-s2-api` secret.
MODAL_S2_TOKEN=
# Sections per HTTP call. The container decodes them in one batch, so GPU cost
# is nearly flat in this number. Keep <= the worker's S2B_BATCH (32). Default 24.
# MODAL_S2_BATCH_SIZE=24
# Concurrent batch calls for one book = independent one-GPU containers (lanes).
# Default 4, clamped to 8. Keep <= the Modal side's live max_containers. That
# live cap is raised at runtime after a production deploy
# (update_autoscaler(max_containers=4)), so the deploy-time S2C_MAX_CONTAINERS
# stays 1 and is not the number to compare against — see step 8 of the staging
# runbook.
# MODAL_S2_SECTION_CONCURRENCY=4
# Sampling as "temperature,top_p". 0.9,0.9 restores the reference's phrasing
# (measured 6.1 vs 6.2 semitones of phrase spread); upstream 0.7,0.7 is flat.
# MODAL_S2_SAMPLING=0.9,0.9
# Warm-call ceiling, clamped to 30–60s. Default 60s. Used once the pool is
# known warm; a pool whose state cannot be read gets the cold wait instead.
# MODAL_S2_TIMEOUT_MS=60000
# How long one book placement may wait for a RESTORING container. A restore is
# ~30–90s. Default 150000. Hard ceiling 180000: a larger value is clamped, so a
# book cannot wait an 8–16 min snapshot compile (or the proxy's ~542s kill).
# Past this budget the placement is dropped, another lane may be tried, and
# the book parks / falls back. The compile is finished by an off-path RPC.
# MODAL_S2_COLD_WAIT_MS=150000
# How long the FIRST-LIGHT call (section 0) waits for a restore. Shorter than a
# normal placement on purpose: that wait is wall clock in front of the person,
# and a compiling placement cannot be waited out anyway (#237). Default 75000
# covers a measured ~57s restore with margin and abandons a compile twice as
# fast. 0 = the full MODAL_S2_COLD_WAIT_MS. Never exceeds it.
# MODAL_S2_FIRST_LIGHT_WAIT_MS=75000
# Render section 0 alone before opening the rest of the fan-out. Default on:
# nothing is playable until section 0 is, and a container answers a whole batch
# together, so batching it beside a neighbour delays the first audio. Everything
# after section 0 then rides ONE call as full as MODAL_S2_BATCH_SIZE allows — a
# one-row call runs at 2.9x realtime and a full call at 35-65x, which is where
# most of the cold wall clock went on job db10a6d6. 0 restores the old
# all-lanes-at-once wave.
# MODAL_S2_FIRST_LIGHT=1
# The same RPC also starts before the book exists, for an account that already
# has a trained clone: when extract is accepted, and when the voice list asks
# POST /clone-prewarm. A container that finished restoring is a ~16-20s first
# section. One still booting does not take the HTTP call, so a fast click
# stays ~68s. Stock-only accounts never start a GPU. An unused start is about
# $0.26 (restore plus the 180s scaledown) at $3.95/hr. MODAL_S2_WARM_HOOK=0
# disables this along with the compile kick. min_containers stays 0.
# Characters one clone batch call may carry. Derived by default from the
# generation budget (MODAL_S2_COLD_WAIT_MS minus a 70s restore/prep margin) at a
# conservative aggregate rate: 8000 at production defaults, which is also the
# operator stopgap. An override may only LOWER it — a hard ceiling keeps an
# oversized pack from ever being planned again (job 7e4a8b48, 2026-11-06).
# MODAL_S2_LANE_MAX_CHARS=
# Characters per clone SECTION. A row renders its paragraph units in sequence
# at ~50 chars/s, and a call's wall time is set by its longest row, so a section
# bigger than a call can never render. Default 2000: ~40s per row, and four of
# them still batch into one 8000-char call. Packing at the Fish 8000 ceiling is
# what produced the four 7.7k sections that stalled that book.
# MODAL_S2_SECTION_CHARS=2000
# Modal credentials for that RPC (`modal run modal/s2_clone_warm.py::cover`).
# Without them the book still will not wait; an operator runs cover instead.
# One kick at a time (20 min). MODAL_S2_WARM_HOOK=0 disables it.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_S2_APP_NAME=echomancer-s2-clone
# MODAL_S2_WARM_HOOK=1
# How long a book may wait for a warm container before it is allowed to finish
# on the fallback engine (with a warning on the job). Default 25 min. 0 = old
# fail-fast behaviour, for a rollback.
# MODAL_S2_DEFER_MS=1500000
# Readiness probe. It reports "a container finished restoring", not "a runner
# exists", and it is a SEPARATE @modal.fastapi_endpoint with its own hostname —
# there is no /ready on the synthesize host, so it is never derived from
# MODAL_S2_TTS_URL. Unset means no probe and the call's own timeout decides.
# A 503 or a timeout parks the book for a while. 404 stays optimistic.
# MODAL_S2_READY_TIMEOUT_MS=5000
# MODAL_S2_READY=0
# There is no per-account or global character allowance for clone audio.
# (Removed 2026-11-07 at product direction: a book must not stop generating at
# an app-invented daily number. Nothing reads MODAL_S2_USER_DAILY_CHARS /
# MODAL_S2_GLOBAL_DAILY_CHARS, so a leftover value in an old .env is inert.)
# Usage is still recorded to `usage_logs` (action `modal_s2_clone`) for cost
# reporting, and recording can never block generation. Real provider quota,
# auth and billing errors still surface as errors.
# Same key as Vercel — listen-prep fallback. Section transcript QA uses this
# key ONLY when TTS_QA_PROVIDER=deepgram; the default is self-hosted Whisper.
OPENROUTER_API_KEY=

# ── Section transcript QA ───────────────────────────────────────────────
# local (default) = self-hosted Whisper in scripts/whisper-qa.py.
#   Requires: pip install faster-whisper, and ffmpeg on PATH.
#   Measured on 4 vCPU: base int8, ~5% WER on neural TTS, RTF 0.02,
#   0.07 CPU-minutes per audio-minute. ~10x faster than Edge generation,
#   so every section is checked; nothing is sampled.
# deepgram = hosted deepgram/nova-3 through OPENROUTER_API_KEY (paid).
# off      = no transcript check.
# TTS_QA_PROVIDER=local
# TTS_QA_WHISPER_MODEL=base      # base | small
# TTS_QA_WHISPER_COMPUTE=int8
# TTS_QA_WHISPER_BEAM=1
# TTS_QA_WHISPER_BUDGET_MS=      # default audioSec*400, 10s-180s
# TTS_SECTION_QA_ENABLED=0       # skip QA entirely
# Squeak check is off. A labelled set of 10 detector hits had 0 true squeaks.
# TTS_SQUEAK_CHECK=1 turns detection and the notch back on.
# TTS_SQUEAK_REGENERATE=1 also re-speaks the whole section. Leave both unset.
# TTS_SQUEAK_CHECK=1
# TTS_SQUEAK_REGENERATE=1
# Whole-book cleanup. MiMo first (reasoning off); DeepSeek only as a checked fallback.
# Leave LISTEN_PREP_MODEL unset to use the code default. An explicit Gemini value overrides it.
# LISTEN_PREP_MODEL=xiaomi/mimo-v2.6-flash
# LISTEN_PREP_REASONING=off
# LISTEN_PREP_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# LISTEN_PREP_CONCURRENCY=8
# LISTEN_PREP_GLOBAL_CONCURRENCY=20
# LISTEN_PREP_CHUNK_TIMEOUT_MS=20000
# GEMINI_API_KEY=
# XAI_API_KEY=

# ── Paradee (self-hosted "Echomancer Andrew") ────────────────────────────
# The Python sidecar in scripts/paradee/server.py (see scripts/paradee/README.md).
# Leave PARADEE_URL empty on Vercel; the worker proxies /paradee/synthesize.
PARADEE_URL=http://127.0.0.1:8791
# Optional. When the sidecar sets PARADEE_SECRET, this process and the worker
# proxy must send the same value as a Bearer token.
# PARADEE_SECRET=
# Paradee sections in flight for one book (the CPU student is the bottleneck).
TTS_PARADEE_FANOUT=3

# ── Worker knobs ─────────────────────────────────────────────────────────
# Keep concurrency at 1 until a full book has mastered without the OOM killer.
# pm2 also sets WORKER=1, WORKER_HOST=127.0.0.1, TTS_MASTER_FULL_BOOK=1.
WORKER_CONCURRENCY=1
WORKER_DRAIN_INTERVAL_MS=15000
TTS_VM_WAVE_BUDGET_MS=900000
TTS_LEASE_TTL_SECONDS=90
TTS_SECTIONS_PER_TICK=8
# Edge and Google sections in one book. Fish and clones ignore this (max 5).
TTS_EDGE_GOOGLE_SECTION_CONCURRENCY=8
TTS_TAKEHOME_FANOUT=
TTS_RETRY_BACKOFF_MS=1000
# WORKER_HOST=127.0.0.1
# DEEP_FILTER_BIN=/usr/local/bin/deep-filter
# TTS_MASTER_SKIP=1
# TTS_MASTER_DFN=1
# TTS_MASTER_DFN_WET=0.4
# FFMPEG_PATH=/usr/bin/ffmpeg
# ECHOMANCER_SCRATCH_DIR=/tmp/echomancer
# ECHOMANCER_SCRATCH_MAX_AGE_HOURS=24
# ECHOMANCER_SCRATCH_SWEEP_MS=900000
# TTS_FINALIZE_TIMEOUT_MS=21600000

# ── Optional local chapter classifier ────────────────────────────────────
# Off by default. A zero-shot NLI model run in-process on the CPU, applied only
# to short title-shaped lines that the plain-text heading rules are unsure
# about. It only ever vetoes a marker the rules accepted; promotion is a
# separate opt-in. See docs/chapter-corpus-results.md.
# CHAPTER_CLASSIFIER=1
# CHAPTER_CLASSIFIER_VETO_BELOW=0.22
# CHAPTER_CLASSIFIER_PROMOTE_ABOVE=0.72
