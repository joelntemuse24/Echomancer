# Copy to .env.worker on the VM (never commit the real file).
#   cp env.worker.example .env.worker
#
# Oracle Always Free + pm2 is the primary runbook (WORKER.md).
# Same Turso + R2 + TTS keys as Vercel. This process synthesizes Whole book.
# It does not parse uploads — keep EXTRACT_WORKER_URL pointed at Cloudflare.

# ── Shared secret (must match Vercel WORKER_SECRET) ──
WORKER_SECRET=
# INTERNAL_JOB_SECRET=   # optional alias; WORKER_SECRET alone is enough

# ── Turso ────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=

# ── Cloudflare R2 ────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=echomancer-audio
# R2_PUBLIC_URL=

# ── TTS ──────────────────────────────────────────────────────────────────
# Edge stock (Standard / Michelle) needs no extra key.
FISH_API_KEY=
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_ACCESS_TOKEN=
# Same key as Vercel — Whole-book Fish / Edge / Google cue tagging.
OPENROUTER_API_KEY=
# Whole-book cleanup. Gemini first; DeepSeek only as a checked fallback.
# LISTEN_PREP_MODEL=google/gemini-3.8-flash
# LISTEN_PREP_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# LISTEN_PREP_CONCURRENCY=8
# LISTEN_PREP_GLOBAL_CONCURRENCY=20
# LISTEN_PREP_CHUNK_TIMEOUT_MS=20000
# FISH_CUE_TAGGER_MODEL=deepseek/deepseek-v4-flash
# FISH_CUE_TAGGER_TIMEOUT_MS=40000
# FISH_CUE_TAGGER=0
# Expressive twins stay off until a clone id exists AND the ears gate passes.
# Each ref is a private fast Fish clone of that slot's Edge/Google voice.
# Set the same pair on Vercel. See fish-stock-twins.ts.
# FISH_TWIN_STANDARD=1
# FISH_TWIN_STANDARD_REF=
# FISH_TWIN_MICHELLE=1
# FISH_TWIN_MICHELLE_REF=
# FISH_TWIN_RANDOLPH=1
# FISH_TWIN_RANDOLPH_REF=
# GEMINI_API_KEY=
# XAI_API_KEY=

# ── Worker knobs ─────────────────────────────────────────────────────────
# Always Free A1 Flex (2 OCPU / 12 GB): keep concurrency at 1.
# pm2 also sets WORKER=1, WORKER_HOST=127.0.0.1, TTS_MASTER_FULL_BOOK=1.
WORKER_CONCURRENCY=1
WORKER_DRAIN_INTERVAL_MS=15000
TTS_VM_WAVE_BUDGET_MS=900000
TTS_LEASE_TTL_SECONDS=90
TTS_SECTIONS_PER_TICK=6
TTS_TAKEHOME_FANOUT=
TTS_RETRY_BACKOFF_MS=1000
# WORKER_HOST=127.0.0.1
# DEEP_FILTER_BIN=/usr/local/bin/deep-filter
# TTS_MASTER_SKIP=1
# TTS_MASTER_DFN=1
# TTS_MASTER_DFN_WET=0.4
# FFMPEG_PATH=/usr/bin/ffmpeg
# ECHOMANCER_SCRATCH_DIR=/tmp/echomancer
# ECHOMANCER_SCRATCH_MAX_AGE_HOURS=24
# ECHOMANCER_SCRATCH_SWEEP_MS=900000
# TTS_FINALIZE_TIMEOUT_MS=21600000
